# SQLite database
AIR_DB_PATH=backend/air_monitor.db

# MQTT; leave MQTT_HOST empty for REST-only local development
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=0

# Monitoring behavior
ONLINE_TIMEOUT_SECONDS=90
ALARM_DEDUP_SECONDS=900
CONSECUTIVE_LIMIT=3
RAW_DATA_RETENTION_DAYS=30
CLEANUP_INTERVAL_SECONDS=86400
BACKUP_DIR=backend/backups
LOG_LEVEL=INFO
API_KEY=
CORS_ORIGINS=*
MAX_QUERY_RANGE_SECONDS=604800
